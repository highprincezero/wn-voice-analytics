# Copy to backend/.env or export these in the shell.
# docker compose already sets mock-mode defaults and does not need this file.

DATABASE_URL=postgresql+psycopg://voice:voice@localhost:5432/voice
JWT_SECRET=dev-only-secret-change-me-please
JWT_EXPIRE_MINUTES=1440

# mock runs with no cloud keys. azure calls Azure OpenAI and Content Safety.
LLM_PROVIDER=mock
SAFETY_PROVIDER=mock
BLOB_PROVIDER=memory
ANALYSIS_MODE=inline
BROKER=celery

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=voice

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=gpt-4o-transcribe
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini

AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
CONTENT_SAFETY_BLOCK_SEVERITY=4

SERVICE_BUS_CONNECTION_STRING=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/2
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# memory is a single-process counter. Compose and Azure set redis.
RATE_LIMIT_BACKEND=memory
ROLLUP_SCHEDULE_SECONDS=900

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=voice-analytics-api

CHUNK_CHARS=4000
MAX_CHUNKS=20
MAX_UPLOAD_BYTES=20971520
HOME_REGION=local

# Streamlit
API_BASE_URL=http://localhost:8000

# Optional schema test
POSTGRES_TEST_URL=postgresql://voice:voice@localhost:5432/voice_test
