# Copy to .env in the repo root: cp .env.example .env
#
# Docker Compose does not load this whole file into the containers. It only fills the
# ${VAR} references in docker-compose.yml. Under Docker, these lines apply:
#   LLM_PROVIDER, SAFETY_PROVIDER, AZURE_OPENAI_*, AZURE_CONTENT_SAFETY_*,
#   CONTENT_SAFETY_BLOCK_SEVERITY, APPLICATIONINSIGHTS_CONNECTION_STRING,
#   LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY, LANGFUSE_HOST, and the optional
#   LANGFUSE_* settings for the local Langfuse (see docker-compose.yml).
# Every other line is host-only: it is read when you run the API, worker, Streamlit or
# pytest straight on your machine (outside Docker). Compose sets its own values for
# those (JWT_SECRET, DATABASE_URL, BLOB_PROVIDER, ANALYSIS_MODE, Redis URLs and so on).

# ---------- MAIN SETTINGS
# Mock mode (the default) needs no keys: leave the Azure lines empty.
# Set LLM_PROVIDER=azure and fill the Azure OpenAI lines to use the real models.

# Azure OpenAI. Leave the temperature empty. gpt-5-mini rejects a temperature of 0.
LLM_PROVIDER=mock
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=gpt-4o-transcribe
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_CHAT_TEMPERATURE=

# Sign-in secret for running the API on your machine (outside Docker). Compose sets its own.
# Use a long random value anywhere real.
JWT_SECRET=dev-only-secret-change-me-please

# ----------

# -------------
# -------------
# Not required on a local run. Fill a line only when that provider is azure.
# -------------
# -------------

# Content Safety. Required only when SAFETY_PROVIDER=azure.
SAFETY_PROVIDER=mock
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
CONTENT_SAFETY_BLOCK_SEVERITY=4

# Blob. Required only when BLOB_PROVIDER=azure.
BLOB_PROVIDER=memory
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=voice

# Service Bus. Required for the Azure worker. Local Celery leaves this empty.
SERVICE_BUS_CONNECTION_STRING=

# Application Insights. Empty turns telemetry off.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Langfuse tracing (applies in Docker). Empty keys turn tracing off.
# To send traces to the local Langfuse (http://localhost:3000), set the keys of its
# pre-created project: pk-lf-local-dev and sk-lf-local-dev.
# LANGFUSE_HOST is the address the worker container uses. Running outside Docker, use http://localhost:3000.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse-web:3000

# -------------
# -------------
# Local defaults. Leave these.
# -------------
# -------------

DATABASE_URL=postgresql+psycopg://voice:voice@localhost:5432/voice
JWT_EXPIRE_MINUTES=1440
ANALYSIS_MODE=inline
BROKER=celery

# Compose sets this to the Azurite MCP server. Empty skips the tool and uses the bytes already loaded.
MCP_AUDIO_URL=

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/2
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# memory is a single-process counter. Compose and Azure set redis.
RATE_LIMIT_BACKEND=memory
ROLLUP_SCHEDULE_SECONDS=900

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=voice-analytics-api

# Pause before each pipeline stage so the assistant flowchart can move.
# Compose sets 1.5. Leave at 0 for tests and for Azure.
MOCK_STAGE_DELAY_SEC=0

CHUNK_CHARS=4000
MAX_CHUNKS=20
MAX_UPLOAD_BYTES=20971520
HOME_REGION=local

# Streamlit
API_BASE_URL=http://localhost:8000

# Optional schema test (host-only). Create the database first:
#   docker compose exec postgres createdb -U voice voice_test
# NEVER point this at the app database `voice`: the test runs DROP SCHEMA public CASCADE.
POSTGRES_TEST_URL=postgresql://voice:voice@localhost:5432/voice_test
